.work/

# Infor's distribution is never committed
*.jar
!resources/*.jar

# macOS / editor noise
.DS_Store
__pycache__/
*.pyc

# leftover verification scratch
.work-verify.class

# Infor artwork is generated at build time from the installer
*.ico
*.icns
